{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/server/index.ts",
        "src/client/main.tsx",
        "src/**/*.test.{ts,tsx}",
        "scripts/*.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"]
    },
    "apps/mobile": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["babel-preset-expo", "zod"]
    }
  },
  "ignoreBinaries": ["index.js"]
}
