{
  "name": "bun-fullstack-boilerplate",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2",
    "node": "24.19.0"
  },
  "scripts": {
    "dev": "bun --watch src/server/index.ts",
    "build": "bun run scripts/build.ts",
    "compiler:report": "bun run scripts/react-compiler-report.ts",
    "start": "cd dist && bun index.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "voice:generate": "bun run scripts/generate-voice-artifacts.ts",
    "voice:check": "bun run scripts/generate-voice-artifacts.ts --check",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run typecheck:mobile && bun run voice:check && bun run knip && bun test",
    "dev:mobile": "bun run --cwd apps/mobile start",
    "dev:mobile:staging": "bun run --cwd apps/mobile start:staging",
    "typecheck:mobile": "bun run --cwd apps/mobile typecheck",
    "db:up": "docker compose up -d db",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:seed": "bun run scripts/seed.ts",
    "db:setup": "bun run db:up && bun run scripts/wait-for-db.ts && bun run db:migrate && bun run db:seed",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  }
}
